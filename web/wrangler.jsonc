{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khelbinaki",
  "compatibility_date": "2026-09-01",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "API_URL": "https://khelbinaki-api.zlabz.workers.dev"
  },
  "preview_urls": true
}
